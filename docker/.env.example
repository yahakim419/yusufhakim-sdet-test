# Copy to docker/.env and adjust. Used by docker compose --env-file.
# Same file works on Mac and Windows.

COMPOSE_PROJECT_NAME=yusufhakim-sdet

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rakamin_development

# Rails / Figaro (injected into api + sidekiq containers)
RAILS_ENV=development
SECRET_KEY_BASE=local_docker_dev_secret_key_base_change_me_please_32
DB_HOST=postgres
DB_PORT=5432
DB_NAME=rakamin_development
DB_USERNAME=postgres
DB_PASSWORD=postgres
REDIS_URL=redis://redis:6379/1
APP_BASE_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:5173
TOKEN_EXPIRATION_TIME=259200

# Gemini — placeholders OK for non-AI smoke tests in development
GEMINI_API_KEY=your_gemini_api_key
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001
GEMINI_FLASH_MODEL=gemini-2.0-flash-001
GEMINI_PRO_MODEL=gemini-2.0-pro-001

# Puma: single process is simpler for local containers
WEB_CONCURRENCY=0
RAILS_MAX_THREADS=5
PORT=3001
